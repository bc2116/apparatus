# The payload contract pins raw bytes. Keep its source, embedded copy, profiles,
# and render templates on LF so native builds agree across supported systems.
starter/payload/** text eol=lf
starter/profiles/** text eol=lf
packages/apparatus-core/src/apparatus_core/starter/** text eol=lf
packages/apparatus-core/src/apparatus_core/shims/*.template text eol=lf
conformance/golden/egress/* text eol=lf
