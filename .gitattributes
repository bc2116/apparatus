# The payload contract pins raw bytes. Keep its source, embedded copy, profiles,
# and render templates on LF so native builds agree across supported systems.
starter/payload/** text eol=lf
starter/profiles/** text eol=lf
packages/apparatus-core/src/apparatus_core/starter/** text eol=lf
packages/apparatus-core/src/apparatus_core/shims/*.template text eol=lf
conformance/golden/egress/* text eol=lf

# Native wrapper builds embed or execute these exact tracked bytes. Pin each
# current text input explicitly so checkout policy cannot introduce byte drift.
installer/windows/bootstrap-apparatus.ps1 text eol=lf
installer/windows/build-installer.ps1 text eol=lf
installer/windows/apparatus-installer.iss text eol=lf
installer/macos/bootstrap-apparatus.sh text eol=lf
installer/macos/build-package.sh text eol=lf
installer/macos/verify-package.sh text eol=lf
installer/macos/package-scripts/postinstall text eol=lf
